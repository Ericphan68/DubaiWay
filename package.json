  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.17",
    "@types/node": "^20.17.12",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "2.1.8",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
