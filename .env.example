# ==============================================================================
# DubaiWay — biến môi trường mẫu
# Sao chép file này thành `.env.local` (dev) hoặc cấu hình trên Hostinger (prod).
# KHÔNG commit giá trị thật. Tất cả biến public dùng tiền tố NEXT_PUBLIC_.
# ==============================================================================

# --- Thông tin liên hệ hiển thị trên site ---
NEXT_PUBLIC_SITE_URL=https://dubaiway.com
NEXT_PUBLIC_WHATSAPP_NUMBER=971500000000
NEXT_PUBLIC_HOTLINE=+84900000000
NEXT_PUBLIC_CONTACT_EMAIL=hello@dubaiway.com
NEXT_PUBLIC_FANPAGE_URL=https://facebook.com/dubaiway

# --- Link đối tác (affiliate / chuyển hướng đặt vé & khách sạn) ---
NEXT_PUBLIC_PARTNER_FLIGHTS_1=https://partner-flights-1.example.com
NEXT_PUBLIC_PARTNER_FLIGHTS_2=https://partner-flights-2.example.com
NEXT_PUBLIC_PARTNER_FLIGHTS_3=https://partner-flights-3.example.com
NEXT_PUBLIC_PARTNER_HOTELS_1=https://partner-hotels-1.example.com
NEXT_PUBLIC_PARTNER_HOTELS_2=https://partner-hotels-2.example.com

# --- Mạng xã hội ---
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/dubaiway
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/@dubaiway
