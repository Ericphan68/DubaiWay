# ==============================================================================
# DubaiWay — biến môi trường mẫu
# Sao chép thành `.env.local` (dev) hoặc cấu hình trên máy chủ (prod).
# KHÔNG commit giá trị thật. Biến hiển thị phía client bắt buộc có tiền tố NEXT_PUBLIC_.
#
# THIẾU BIẾN KHÔNG LÀM SẬP ỨNG DỤNG: hệ thống tự chuyển sang adapter giả lập
# và in cảnh báo lúc khởi động. Xem docs/SETUP.md.
# ==============================================================================

# --- Thông tin site ---
NEXT_PUBLIC_SITE_URL=https://www.shalom1379.com
NEXT_PUBLIC_DEFAULT_LOCALE=vi
NEXT_PUBLIC_DEFAULT_CURRENCY=USD

# --- Ba cửa vào: khách / đối tác / quản trị ---
# MẶC ĐỊNH cả ba chạy chung một tên miền, phân biệt bằng đường dẫn:
#     https://tenmien.com            → khách hàng
#     https://tenmien.com/khu-doi-tac   → đối tác
#     https://tenmien.com/khu-quan-tri  → quản trị
#
# Khi đã tạo subdomain và cấp SSL trên máy chủ thì đặt =on để tách hẳn:
#     https://merchant.tenmien.com   → đối tác
#     https://admin.tenmien.com      → quản trị
NEXT_PUBLIC_AREA_HOSTS=

# Chỉ dùng khi tên miền khu vực KHÔNG cùng gốc với trang chính.
# Bỏ trống thì tự suy ra: merchant.<gốc> và admin.<gốc>.
NEXT_PUBLIC_MERCHANT_HOST=
NEXT_PUBLIC_ADMIN_HOST=

# --- Supabase (database + auth + storage) ---
# Thiếu → dùng repository trong bộ nhớ, đủ để chạy thử giao diện.
# Lấy tại: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# CHỈ dùng phía server. Khoá này bỏ qua toàn bộ RLS — không bao giờ để lộ ra client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Thanh toán (Stripe) ---
# Thiếu → dùng cổng sandbox nội bộ. Đặt khoá thật CHỈ khi adapter Stripe đã triển khai.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email giao dịch ---
# Thiếu → email chỉ in ra console, không gửi đi đâu.
RESEND_API_KEY=
EMAIL_FROM=DubaiWay <no-reply@dubaiway.com>

# --- Thông tin liên hệ hiển thị trên site ---
NEXT_PUBLIC_WHATSAPP_NUMBER=971500000000
NEXT_PUBLIC_HOTLINE=+84900000000
NEXT_PUBLIC_CONTACT_EMAIL=hello@dubaiway.com
NEXT_PUBLIC_FANPAGE_URL=https://facebook.com/dubaiway
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/dubaiway
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/@dubaiway

# --- Link đối tác (mảng vé máy bay & khách sạn giai đoạn chuyển tiếp) ---
NEXT_PUBLIC_PARTNER_FLIGHTS_1=
NEXT_PUBLIC_PARTNER_FLIGHTS_2=
NEXT_PUBLIC_PARTNER_FLIGHTS_3=
NEXT_PUBLIC_PARTNER_HOTELS_1=
NEXT_PUBLIC_PARTNER_HOTELS_2=
